---
import SocialLinks from "./SocialLinks.astro";
import { SITE_EMAIL, SITE_LOCATION } from "../consts";
---

<footer>
  <div class="footer">
    <div class="me">
      <p class="name">Jessaí<br />Maya</p>
      <p class="position">Front-end developer</p>
    </div>
    <div class="contacts">
      <h2>.../Contacts...</h2>
      <a href={`mailto:${SITE_EMAIL}`} class="email" title="Email me"
        >{SITE_EMAIL}</a
      >
      <span class="location">{SITE_LOCATION}</span>
    </div>
    <div class="links">
      <ul class="nav-list">
        <li><a href="/" class="nav-link" title="Home">Home</a></li>
        <li><a href="/blog" class="nav-link" title="Blog">Blog</a></li>
        <li><a href="/cv" class="nav-link" title="CV">CV</a></li>
      </ul>
      <p class="site">
        Handcrafted by Me / Designed by <a
          href="https://www.behance.net/taisia_pro"
          title="Designer Taisia">Taisia</a
        > / Powered by <a href="https://astro.build/" title="astro">Astro</a>
      </p>
    </div>
  </div>
  <div class="social">
    <SocialLinks />
  </div>
</footer>
<style>
  footer {
    margin-top: var(--space-xl);
    padding: var(--space-m) var(--space-s) 0;
    border-top: 1px solid color-mix(in srgb, var(--gray) 35%, transparent);
    font-family: "Open Sans", sans-serif;
    font-size: var(--step--1);
  }
  .footer {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: var(--space-m);
    align-items: start;
  }
  p {
    margin: 0;
  }
  /* Same treatment as the name in the header */
  .name {
    font-weight: 300;
    font-size: var(--step-0);
    line-height: 1.2;
    color: var(--accent);
  }
  .position,
  .location {
    color: var(--gray);
    margin-top: var(--space-3xs);
  }
  .contacts {
    display: flex;
    flex-direction: column;
  }
  .contacts h2 {
    font-family: "FiraCode", monospace;
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--gray);
    margin: 0 0 var(--space-3xs);
  }
  .email {
    color: var(--accent);
    text-decoration: none;
    border-bottom: solid 1px var(--gray);
    align-self: flex-start;
  }
  .links {
    justify-self: end;
    text-align: right;
  }
  .nav-list {
    list-style: none;
    display: flex;
    justify-content: flex-end;
    gap: var(--space-s);
    margin: 0 0 var(--space-2xs);
    padding: 0;
  }
  .nav-link {
    color: var(--accent);
    text-decoration: none;
  }
  .site {
    color: var(--gray);
    line-height: 1.6;
  }
  .site a {
    color: var(--gray);
  }
  a:hover,
  .site a:hover {
    color: var(--accent);
  }
  .social {
    margin: var(--space-s) 0 var(--space-m);
  }
  @media (max-width: 48rem) {
    .footer {
      grid-template-columns: 1fr;
    }
    .links {
      justify-self: start;
      text-align: left;
    }
    .nav-list {
      justify-content: flex-start;
    }
  }
</style>
