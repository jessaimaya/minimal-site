---
import { skills as groups } from "../data/cv";
---

<section class="about-me" id="about">
  <div class="intro">
    <h2>.../About me...</h2>
    <div class="salute">
      <p>
        Hi! I'm Jessaí Maya, a <strong>Frontend Engineer &amp; Architect</strong>
        with over <strong>14 years</strong> of experience building <strong
          >enterprise-scale UI systems</strong
        > for regulated industries, most recently fintech. I work at the level of
        <strong>architecture</strong>, <strong>performance</strong>, and the
        shared UI infrastructure product teams build on, such as component
        systems, build tooling and accessibility standards that hold up as
        codebases grow.
      </p>
      <p>
        Trained in <strong>art and animation</strong>. Currently building with <strong
          >LLM APIs, agents and MCP</strong
        >, alongside games and generative graphics.
      </p>
    </div>
  </div>
  <div class="stack">
    <div class="description">
      <div class="cards">
        {
          groups.map((group) => (
            <div class:list={["card", { feature: group.feature }]} id={group.id}>
              <h3>{group.title}</h3>
              <p>{group.items.join(" / ")}</p>
            </div>
          ))
        }
        <div class="link">
          <a href="https://github.com/jessaimaya" title="GitHub">
            <span class="icon">
              <svg
                role="img"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
                ><title>GitHub</title><path
                  d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
                ></path></svg
              >
            </span>
            <span class="arrow">↗</span>
          </a>
        </div>
      </div>
    </div>
    <div class="photo">
      <img
        src="/img/jessai_maya_profile_picture.jpg"
        alt="Jessaí Maya"
        width="480"
        height="480"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .about-me {
    position: relative;
  }
  .intro {
    margin: var(--space-l-xl) 0;
    display: flex;
    justify-content: space-between;
    gap: var(--space-m);
  }
  h2 {
    flex: 1;
    display: flex;
    font-size: var(--step-0);
    text-decoration: none;
    font-weight: normal;
    font-family: "Open Sans", sans-serif;
    color: var(--accent);
  }
  .salute {
    flex: 2;
  }
  .salute p {
    font-weight: normal;
    font-size: var(--step-0);
    font-family: "Open Sans", sans-serif;
    color: var(--gray);
    margin: 0 0 var(--space-s);
  }
  .salute p:last-child {
    margin-bottom: 0;
  }
  strong {
    display: inline;
    color: var(--accent);
  }
  .stack {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: var(--space-m);
  }
  .description {
    flex: 3;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-s);
    align-items: stretch;
  }
  .card {
    color: var(--accent);
    background-color: transparent;
    border: solid 1px var(--accent);
    border-radius: var(--space-m);
    padding: var(--space-s);
  }
  .card.feature {
    color: var(--background);
    background-color: var(--accent);
    border-color: var(--accent);
  }
  #frontend {
    grid-column: 1 / -1;
  }
  .link {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  a {
    --icon-size: var(--space-l-xl);
    position: relative;
    display: block;
    width: var(--icon-size);
    height: var(--icon-size);
  }
  .icon {
    z-index: 0;
    position: absolute;
    width: var(--icon-size);
    height: var(--icon-size);
    border: solid 1px var(--accent);
    background-color: var(--accent);
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: var(--icon-size);
  }
  .arrow {
    top: 0;
    right: 0;
    width: var(--icon-size);
    height: var(--icon-size);
    position: absolute;
    color: var(--background);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0.1rem;
    background-color: var(--accent);
    border-radius: var(--icon-size);
    margin-right: calc(calc(var(--icon-size) / 2) * -1);
    margin-top: calc(calc(var(--icon-size) / 2) * -1);
  }
  svg {
    width: var(--icon-size);
    height: var(--icon-size);
    fill: var(--background);
  }
  .photo {
    flex: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  img {
    max-width: 80%;
    height: auto;
    border-radius: var(--step-1);
  }
  h3 {
    font-weight: normal;
    margin: 0;
    font-family: "Open Sans", sans-serif;
  }
  .card p {
    font-size: var(--step--1);
    margin: var(--space-2xs) 0 0;
  }

  @media (max-width: 48rem) {
    .intro {
      padding: var(--step-0);
      flex-direction: column;
      margin: 0 auto;
    }
    h2 {
      font-size: var(--step-3);
    }
    .salute p {
      font-size: var(--step-1);
    }
    .stack {
      padding: var(--step-0);
      flex-direction: column-reverse;
      justify-content: space-between;
      align-items: center;
    }
    .description {
      width: 100%;
    }
    .cards {
      grid-template-columns: 1fr;
    }
    .photo {
      margin: var(--space-l);
    }
    img {
      max-width: 100%;
    }
    .card.feature {
      font-size: var(--step-1);
    }
    .card p {
      font-size: var(--step-0);
    }
  }
</style>
